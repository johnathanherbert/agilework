# Firebase Configuration
# Get these values from your Firebase project settings
# https://console.firebase.google.com/

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Deprecated - Supabase (will be removed)
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Dashpesagem API via Cloudflare
NEXT_PUBLIC_DASHPESAGEM_API_URL=https://dash.agilework.app.br

# Firebase Admin SDK (necessário para redefinição de senha direta sem e-mail)
# Obtenha o JSON no Firebase Console -> Configurações do Projeto -> Contas de Serviço -> Gerar nova chave privada
# Pode ser configurado como o conteúdo JSON completo:
# FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'
# Ou com credenciais separadas:
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
