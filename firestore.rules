rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the resource
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Helper to check if user is admin
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'johnathan.herbert47@gmail.com' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // Helper to check if user has the 'supervisor' role
    function isSupervisor() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'supervisor';
    }

    // Helper to check if user has the 'leader' role on their own user document
    function isLeader() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'leader';
    }

    // Helper to check if user is a leader with explicit allowedMaoDeObra permission
    function isAuthorizedLeader() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'leader' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('allowedMaoDeObra', false) == true;
    }

    // Helper to check if user has access to Mão de Obra (Admin, Supervisor, ou Líder com permissão)
    function canAccessMaoDeObra() {
      return isAdmin() || isSupervisor() || isAuthorizedLeader();
    }

    // Helper to check if user is Supervisor or Admin
    function isSupervisorOrAdmin() {
      return isAdmin() || isSupervisor();
    }

    // Helper to check if user is admin, supervisor OR leader (Gestão de Produção e Heijunka)
    function isStaffOrAdmin() {
      return isAdmin() || isSupervisor() || isLeader();
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isAdmin() || (
        isOwner(userId) &&
        request.resource.data.get('role', null) == resource.data.get('role', null) &&
        request.resource.data.get('isApproved', null) == resource.data.get('isApproved', null) &&
        request.resource.data.get('allowedMaoDeObra', null) == resource.data.get('allowedMaoDeObra', null)
      );
      allow delete: if isAdmin();
    }

    // Operators collection - Gestão de Mão de Obra (Operadores de Produção)
    match /operators/{operatorId} {
      allow read: if canAccessMaoDeObra();
      allow create: if canAccessMaoDeObra();
      allow update: if canAccessMaoDeObra();
      allow delete: if canAccessMaoDeObra();
    }

    // Labor Occurrences collection - Ocorrências, Atestados, Faltas, Folgas Flexíveis e Férias
    // Tratativas e parecer da supervisão restritos exclusivamente a Supervisão e Admin
    match /labor_occurrences/{occurrenceId} {
      allow read: if canAccessMaoDeObra();
      allow create: if canAccessMaoDeObra() && (
        isSupervisorOrAdmin() || (
          // Líder não pode cadastrar tratativas disciplinares da supervisão na criação
          !request.resource.data.keys().hasAny([
            'obsSupervisao', 'obsSupervisaoUpdatedAt', 'obsSupervisaoUpdatedBy',
            'tratativaStatus', 'tratativaPriority', 'tratativaPassos', 'prazoTratativa'
          ])
        )
      );
      allow update: if canAccessMaoDeObra() && (
        isSupervisorOrAdmin() || (
          // Líder não pode alterar tratativas disciplinares da supervisão
          request.resource.data.get('obsSupervisao', null) == resource.data.get('obsSupervisao', null) &&
          request.resource.data.get('obsSupervisaoUpdatedAt', null) == resource.data.get('obsSupervisaoUpdatedAt', null) &&
          request.resource.data.get('obsSupervisaoUpdatedBy', null) == resource.data.get('obsSupervisaoUpdatedBy', null) &&
          request.resource.data.get('tratativaStatus', null) == resource.data.get('tratativaStatus', null) &&
          request.resource.data.get('tratativaPriority', null) == resource.data.get('tratativaPriority', null) &&
          request.resource.data.get('tratativaPassos', null) == resource.data.get('tratativaPassos', null) &&
          request.resource.data.get('prazoTratativa', null) == resource.data.get('prazoTratativa', null)
        )
      );
      allow delete: if isSupervisorOrAdmin();
    }
    
    // NTs collection
    match /nts/{ntId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }
    
    // NT Items collection
    match /nt_items/{itemId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAuthenticated();
    }

    // Production Items collection - Painel de Produção (Pesagem)
    match /production_items/{itemId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update: if isStaffOrAdmin();
      allow delete: if isStaffOrAdmin();
    }

    // Heijunka Snapshots collection - Dashboard Heijunka
    match /heijunka_snapshots/{snapshotId} {
      allow read: if isStaffOrAdmin();
      allow create: if isStaffOrAdmin();
      allow update: if isStaffOrAdmin();
      allow delete: if isStaffOrAdmin();
    }
    
    // Custom Routes collection - Cadastro de Ordens, Vias e Rotas (Gerenciamento)
    match /custom_routes/{routeId} {
      allow read: if isAuthenticated();
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && 
                     resource.data.user_id == request.auth.uid;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
                      resource.data.user_id == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.user_id == request.auth.uid;
    }
    
    // Chat messages
    match /chat_messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow delete: if isAuthenticated() && 
                      resource.data.userId == request.auth.uid;
    }
    
    // Private messages
    match /private_messages/{messageId} {
      allow read: if isAuthenticated() && (
        resource.data.senderId == request.auth.uid ||
        resource.data.receiverId == request.auth.uid
      );
      allow create: if isAuthenticated() && 
                      request.resource.data.senderId == request.auth.uid;
      allow update: if isAuthenticated() && 
                      resource.data.receiverId == request.auth.uid;
      allow delete: if isAuthenticated() && 
                      resource.data.senderId == request.auth.uid;
    }
  }
}
